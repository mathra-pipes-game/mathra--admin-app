rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== CHANGE THIS to the admin email you create in Firebase Authentication =====
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'YOUR_ADMIN_EMAIL@gmail.com';
    }

    // ---- Leaderboard (same as before) ----
    match /players/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
            ['name','score','levels','bestSeconds','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 18
          && request.resource.data.score is int
          && request.resource.data.score < 1000000;
      allow delete: if isAdmin();
    }

    // ---- Plans / prices / payment text: everyone reads, ONLY admin writes ----
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Active plan of a phone: the game can only READ its own doc.
    //      ONLY the admin app can create / change / remove it. ----
    match /subs/{deviceId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ---- Orders: a player can only CREATE a "pending" order.
    //      Confirm / reject / delete = admin only. ----
    match /orders/{code} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
            request.resource.data.keys().hasOnly(
              ['deviceId','playerName','planId','planName','days','price','status','createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 20
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() <= 18
          && request.resource.data.planId is string
          && request.resource.data.planId.size() <= 24
          && request.resource.data.planName is string
          && request.resource.data.planName.size() <= 40
          && request.resource.data.days is int
          && request.resource.data.days >= 1
          && request.resource.data.days <= 3660
          && request.resource.data.price is int
          && request.resource.data.price >= 1
          && request.resource.data.price <= 100000
          && request.resource.data.createdAt is int);
    }

    // ---- Anonymous counters (installs, opens, plan-screen views) ----
    match /devices/{id} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || request.resource.data.keys().hasOnly(
            ['firstSeen','lastSeen','opens','planViews','version']);
    }
  }
}
